# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon Data API (PostgREST). Keep this key server-side; do not use VITE_ prefix.
NEON_API_URL="https://ep-morning-breeze-a5m3lsnf.apirest.us-east-2.aws.neon.tech/neondb/rest/v1"
NEON_API_KEY="your_neon_api_key_or_jwt_token_here"

# Telegram check-in bot. The bot forwards messages to CareBridge's Telegram ingestion API.
BOT_TOKEN="your_telegram_bot_token"
CAREBRIDGE_API_URL="http://localhost:3000"
# Optional: enables Telegram voice-note transcription through OpenAI Whisper.
OPENAI_API_KEY=""
